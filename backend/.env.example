# MongoDB Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=invoicechat

# AI Service Configuration
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Payment Configuration (Options: fake | braintree | paypal)
PAYMENT_PROVIDER=braintree

# Braintree sandbox (Settings > API in the Braintree control panel)
BRAINTREE_MERCHANT_ID=your_braintree_merchant_id_here
BRAINTREE_PUBLIC_KEY=your_braintree_public_key_here
BRAINTREE_PRIVATE_KEY=your_braintree_private_key_here

# Each merchant account has one currency. Format: CURRENCY:merchant_account_id, comma-separated
BRAINTREE_MERCHANT_ACCOUNTS=USD:your_usd_merchant_account_id

# true shows a clearly labelled test button that uses Braintree's simulated PayPal payment
BRAINTREE_SIMULATED_PAYPAL=false

# PayPal (only used when PAYMENT_PROVIDER=paypal)
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# Frontend / CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173